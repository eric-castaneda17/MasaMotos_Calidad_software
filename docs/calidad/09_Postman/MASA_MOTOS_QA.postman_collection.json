{
  "info": {
    "name": "MASA MOTOS · QA API",
    "description": "Requiere el lote QA_TEST y el proyecto de QA autorizado. Los ocho casos incluyen solicitudes auxiliares.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "API-01 · Abre sesión de vendedor QA",
          "description": "SWR-AUTH-004 · CA-02 (apoyo)",
          "item": [
            {
              "name": "Credenciales válidas",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "apikey",
                    "value": "{{publicKey}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{sellerEmail}}\",\n  \"password\": \"{{sellerPassword}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                      "pm.test(\"Sesión para la cuenta QA\", function () { const r=pm.response.json(); pm.expect(typeof r.access_token==='string'&&r.access_token.length>0).to.be.true; pm.expect(typeof r.user.id==='string'&&r.user.id.length>0).to.be.true; pm.expect(r.user.email.toLowerCase()===pm.environment.get('sellerEmail').toLowerCase()).to.be.true; });",
                      "if(pm.response.code===200) pm.environment.set('sellerToken',pm.response.json().access_token);",
                      "if(pm.response.code===200) pm.environment.set('sellerId',pm.response.json().user.id);"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
