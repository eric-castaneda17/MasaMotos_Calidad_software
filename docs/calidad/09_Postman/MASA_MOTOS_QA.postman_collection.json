    {
      "name": "Comprobantes",
      "item": [
        {
          "name": "API-08 · Comprobantes consecutivos con detalle",
          "description": "SWR-CPB-001 · CA-12, SWR-CPB-002 · CA-13",
          "item": [
            {
              "name": "Prepara primera venta del caso",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "apikey",
                    "value": "{{publicKey}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{sellerToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{supabaseUrl}}/rest/v1/rpc/create_sale",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"p_customer_id\": {{invoiceCustomerId}},\n  \"p_payment_method_id\": {{cashId}},\n  \"p_discount_type\": \"PERCENT\",\n  \"p_discount_value\": 0,\n  \"p_amount_received\": null,\n  \"p_notes\": \"{{runId}}-API08A\",\n  \"p_items\": [\n    {\n      \"productId\": {{invoiceProductId}},\n      \"quantity\": 1\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                      "pm.test(\"Identificadores de venta y comprobante\", function () { const r=pm.response.json(); pm.expect(Number.isInteger(r.saleId)&&r.saleId>0).to.be.true; pm.expect(Number.isInteger(r.invoiceId)&&r.invoiceId>0).to.be.true; pm.expect(typeof r.invoiceNumber==='string'&&r.invoiceNumber.length>0).to.be.true; });",
                      "if (pm.response.code===200) { const r=pm.response.json(); pm.environment.set('firstSaleId',r.saleId); pm.environment.set('firstInvoiceId',r.invoiceId); pm.environment.set('firstNumber',r.invoiceNumber); }"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Prepara segunda venta del caso",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "apikey",
                    "value": "{{publicKey}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{sellerToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{supabaseUrl}}/rest/v1/rpc/create_sale",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"p_customer_id\": {{invoiceCustomerId}},\n  \"p_payment_method_id\": {{cashId}},\n  \"p_discount_type\": \"PERCENT\",\n  \"p_discount_value\": 0,\n  \"p_amount_received\": null,\n  \"p_notes\": \"{{runId}}-API08B\",\n  \"p_items\": [\n    {\n      \"productId\": {{invoiceProductId}},\n      \"quantity\": 1\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                      "pm.test(\"Identificadores de venta y comprobante\", function () { const r=pm.response.json(); pm.expect(Number.isInteger(r.saleId)&&r.saleId>0).to.be.true; pm.expect(Number.isInteger(r.invoiceId)&&r.invoiceId>0).to.be.true; pm.expect(typeof r.invoiceNumber==='string'&&r.invoiceNumber.length>0).to.be.true; });",
                      "if (pm.response.code===200) { const r=pm.response.json(); pm.environment.set('secondSaleId',r.saleId); pm.environment.set('secondInvoiceId',r.invoiceId); pm.environment.set('secondNumber',r.invoiceNumber); }"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Lee ambos comprobantes",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "apikey",
                    "value": "{{publicKey}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{sellerToken}}"
                  }
                ],
                "url": "{{supabaseUrl}}/rest/v1/invoices?id=in.({{firstInvoiceId}},{{secondInvoiceId}})&select=id,sale_id,number,issued_at"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                      "pm.test(\"Dos números consecutivos y fechas de emisión\", function () { const rows=pm.response.json(); pm.expect(rows.length).to.eql(2); const a=rows.find(r=>String(r.id)===String(pm.environment.get('firstInvoiceId'))); const b=rows.find(r=>String(r.id)===String(pm.environment.get('secondInvoiceId'))); pm.expect(String(a.sale_id)).to.eql(String(pm.environment.get('firstSaleId'))); pm.expect(String(b.sale_id)).to.eql(String(pm.environment.get('secondSaleId'))); pm.expect(a.number).to.eql(pm.environment.get('firstNumber')); pm.expect(b.number).to.eql(pm.environment.get('secondNumber')); const aa=a.number.match(/^(.*-)(\\d+)$/); const bb=b.number.match(/^(.*-)(\\d+)$/); pm.expect(aa[1]).to.eql(bb[1]); pm.expect(Number(bb[2])-Number(aa[2])).to.eql(1); pm.expect(Number.isFinite(Date.parse(a.issued_at))&&Date.parse(b.issued_at)>=Date.parse(a.issued_at)).to.be.true; });"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Vendedor, medio y total de ambas ventas",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "apikey",
                    "value": "{{publicKey}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{sellerToken}}"
                  }
                ],
                "url": "{{supabaseUrl}}/rest/v1/sales?id=in.({{firstSaleId}},{{secondSaleId}})&select=id,customer_id,user_id,payment_method_id,total"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                      "pm.test(\"Ambas ventas del cliente y del vendedor de QA\", function () { const rows=pm.response.json(); pm.expect(rows.length).to.eql(2); for(const r of rows){ pm.expect(String(r.customer_id)).to.eql(String(pm.environment.get('invoiceCustomerId'))); pm.expect(String(r.user_id)).to.eql(String(pm.environment.get('sellerId'))); pm.expect(String(r.payment_method_id)).to.eql(String(pm.environment.get('cashId'))); pm.expect(Number(r.total)).to.eql(29750); } });"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Líneas de ambos comprobantes",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "apikey",
                    "value": "{{publicKey}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{sellerToken}}"
                  }
                ],
                "url": "{{supabaseUrl}}/rest/v1/sale_items?sale_id=in.({{firstSaleId}},{{secondSaleId}})&select=sale_id,product_id,product_code,quantity,unit_price,line_total"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                      "pm.test(\"Detalle de una unidad a 25.000 por venta\", function () { const rows=pm.response.json(); pm.expect(rows.length).to.eql(2); pm.expect(rows.map(r=>String(r.sale_id)).sort()).to.eql([String(pm.environment.get('firstSaleId')),String(pm.environment.get('secondSaleId'))].sort()); for(const r of rows){ pm.expect(String(r.product_id)).to.eql(String(pm.environment.get('invoiceProductId'))); pm.expect(r.product_code.startsWith(pm.environment.get('runId'))).to.be.true; pm.expect([r.quantity,Number(r.unit_price),Number(r.line_total)]).to.eql([1,25000,25000]); } });"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
