    {
      "name": "Catálogo",
      "item": [
        {
          "name": "API-03 · Estados de stock",
          "description": "SWR-BUS-003 · CA-05",
          "item": [
            {
              "name": "Consulta las tres referencias sintéticas",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "apikey",
                    "value": "{{publicKey}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{sellerToken}}"
                  }
                ],
                "url": "{{supabaseUrl}}/rest/v1/products_view?id=in.({{catAvailableId}},{{catLowId}},{{catZeroId}})&select=id,name,code,brand,sale_price,stock,min_stock,stock_status"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                      "pm.test(\"Datos del catálogo y fronteras de stock\", function () { const rows=pm.response.json(); pm.expect(rows.length).to.eql(3); for (const [key,qty,state,brand] of [['catAvailableId',4,'available','Yamaha'],['catLowId',2,'low','Honda'],['catZeroId',0,'out','Yamaha']]) { const r=rows.find(p=>String(p.id)===String(pm.environment.get(key))); pm.expect(r).to.exist; pm.expect(r.name).to.eql(r.code); pm.expect(r.code.startsWith(pm.environment.get('runId'))).to.be.true; pm.expect(r.brand).to.eql(brand); pm.expect(Number(r.sale_price)).to.eql(25000); pm.expect(r.stock).to.eql(qty); pm.expect(r.min_stock).to.eql(2); pm.expect(r.stock_status).to.eql(state); } });"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
