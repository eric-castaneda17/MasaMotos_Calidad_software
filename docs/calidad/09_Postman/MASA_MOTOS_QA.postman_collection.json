    {
      "name": "Permisos",
      "item": [
        {
          "name": "API-07 · Exportación protegida",
          "description": "SWR-AUTH-006 · CA-03",
          "item": [
            {
              "name": "Sin sesión",
              "request": {
                "method": "GET",
