# ─────────────────────────────────────────────────────────────
# MASA MOTOS · Variables de entorno (Supabase) — PLANTILLA
# Copie este archivo como  .env.local  y complete los valores EN .env.local.
# ⚠ NO escriba claves reales en este archivo: se publica con el código.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_...)
# o, en el formato anterior, la clave "anon public" en NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Es pública: la seguridad de los datos la garantizan las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_...)
# o, en "Legacy API keys", la clave "service_role" (eyJhbGciOi...).
# ⚠ SECRETA: solo la usa el servidor (módulo Usuarios y script de configuración).
#   NO es la contraseña de la base de datos. Nunca le ponga el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Solo para `npm run db:setup` (crear tablas y datos de prueba desde la terminal).
# Supabase → botón "Connect" → Session pooler → URI. Reemplace [YOUR-PASSWORD] por la
# contraseña de la base de datos que definió al crear el proyecto.
SUPABASE_DB_URL="postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Cuentas académicas para navegador, suites QA y preparación de usuarios.
# Complete con valores privados en el entorno local. Los campos de esta plantilla quedan vacíos.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_SELLER_EMAIL=
QA_SELLER_PASSWORD=
